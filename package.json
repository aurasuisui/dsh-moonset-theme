{
  "name": "@aurasuisui/dsh-moonset-theme",
  "description": "Moonset (月落) light/dark themes for the DeepSeek Harness web GUI — two palettes registered into the official theme system.",
  "version": "0.1.5",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets",
    "*.map"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "dark-theme",
    "light-theme",
    "moonset"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurasuisui/dsh-moonset-theme.git"
  },
  "homepage": "https://github.com/aurasuisui/dsh-moonset-theme#readme",
  "bugs": {
    "url": "https://github.com/aurasuisui/dsh-moonset-theme/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^26.2.0",
    "tsdown": "~0.22",
    "typescript": "~5.7",
    "vitest": "~4.1"
  }
}
